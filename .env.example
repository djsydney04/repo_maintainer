# Copy to .env locally. Never commit real values or put them in the Dockerfile.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional override for whichever provider is selected in YAML:
SDK_MAINTENANCE_API_KEY=
# Self-hosted Renovate uses this token, independently of model providers:
RENOVATE_TOKEN=
# Optional separate GitHub.com token for changelogs when using GitHub Enterprise:
RENOVATE_GITHUB_COM_TOKEN=
