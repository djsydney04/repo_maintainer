# Copy to .env locally. Never commit real values or put them in the Dockerfile.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CODEX_API_KEY=
# Optional override for whichever provider is selected in YAML:
MAINTENANCE_API_KEY=
# Legacy alias (still supported):
SDK_MAINTENANCE_API_KEY=
# Optional container build settings:
# MAINTAINER_INSTALL_CODEX=true
# MAINTAINER_RUNTIME_IMAGE=node:24-bookworm
# Default runtime is debian:bookworm-slim (Codex, Git, GitHub CLI, Python and build tools).
# Compose supplies isolation and sets MAINTENANCE_CODEX_SANDBOX_DEFAULT=danger-full-access
# for version-2 configs. Explicit YAML sandbox settings take precedence.
# Compose forwards proxy settings to the worker and its configured child checks:
# HTTPS_PROXY=http://proxy.example.internal:8080
# HTTP_PROXY=http://proxy.example.internal:8080
# NO_PROXY=localhost,127.0.0.1,database,service.internal
# With the optional Compose overlays (see docs/docker-networking.md):
# MAINTAINER_PRIVATE_NETWORK=my-services
# MAINTAINER_CA_BUNDLE=/absolute/path/to/full-ca-bundle.pem
# MAINTAINER_DNS_SERVER=10.0.0.53
