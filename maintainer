#!/usr/bin/env bash
set -euo pipefail
maintainer_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
export REPOSITORY_PATH="$(cd -- "${REPOSITORY_PATH:-$PWD}" && pwd)"
export MAINTAINER_UID="$(id -u)" MAINTAINER_GID="$(id -g)"
if [[ "${1:-}" == init ]]; then
  if [[ -e "$REPOSITORY_PATH/.maintainer.yml" ]]; then
    echo '.maintainer.yml already exists; keeping your settings.'
  else
    cp -- "$maintainer_root/maintainer.example.yml" "$REPOSITORY_PATH/.maintainer.yml"
    echo "Created $REPOSITORY_PATH/.maintainer.yml. Configure the task, agent and project checks, then run maintainer check."
  fi
  exit 0
fi
export MAINTAINER_OUTPUT_PATH="${MAINTAINER_OUTPUT_PATH:-$REPOSITORY_PATH/.maintainer-output}"
mkdir -p -- "$MAINTAINER_OUTPUT_PATH"
if [[ $# -eq 0 ]]; then set -- check; fi
compose_files=(-f "$maintainer_root/compose.yml")
if [[ -n "${MAINTAINER_COMPOSE_FILES:-}" ]]; then
  IFS=: read -r -a maintainer_overrides <<< "$MAINTAINER_COMPOSE_FILES"
  for override in "${maintainer_overrides[@]}"; do
    if [[ "$override" != /* ]]; then override="$maintainer_root/$override"; fi
    [[ -f "$override" ]] || { echo "Compose override not found: $override" >&2; exit 2; }
    compose_files+=(-f "$override")
  done
fi
exec docker compose --project-directory "$maintainer_root" "${compose_files[@]}" run --build --rm maintainer "$@" --output "/output/$(date +%s)-$$"
